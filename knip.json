{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "index.html",
    // SEO structured data code protected by specification
    "src/lib/seo.ts",
    "src/__tests__/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,ts,tsx}"
  ],
  "rules": {
    "duplicates": "off"
  }
}
